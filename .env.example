# Create a Neon project, then paste its pooled connection string here.
# Keep this value server-side. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=


# Better Auth session signing secret (generate a unique 32+ character value).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required for verification and password reset emails.
RESEND_API_KEY=
EMAIL_FROM=
